{
  "expo": {
    "name": "Reprise",
    "slug": "reprise",
    "description": "Retrouver et reconduire les points de vue historiques de Paris.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/reprise-app-icon.png",
    "scheme": "reprise",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/reprise-app-icon.png",
      "bundleIdentifier": "fr.youplala.repriseparis",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.youplala.repriseparis",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F233A",
          "image": "./assets/images/reprise-app-icon.png",
          "imageWidth": 184
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Reprise à utiliser l’appareil photo pour reconduire une vue historique.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Reprise à afficher les points de vue historiques autour de vous.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Autoriser Reprise à utiliser l’orientation de l’iPhone pour aligner les prises de vue."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Autoriser Reprise à enregistrer vos reprises dans vos photos, pour les retrouver au moment de les déposer sur l’Observatoire.",
          "photosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b830c4f-b56d-4005-bf87-3560b9efd3f4"
      },
      "snapshotUrl": "https://raw.githubusercontent.com/Youplala/reprise/main/assets/data/observatoire-snapshot.json"
    },
    "owner": "youplala"
  }
}
